generator client {
  provider = "prisma-client-js"
}


datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// ENUM'ы
// ==========================================

enum UserRole {
  volunteer
  organization_creator
  admin
}

enum RegistrationStatus {
  pending
  approved
  rejected
  completed
}

// ==========================================
// 1. ПОЛЬЗОВАТЕЛИ (Аутентификация)
// ==========================================

model User {
  id            Int       @id @default(autoincrement())
  email         String?   @unique @db.VarChar(255)
  passwordHash  String?   @map("password_hash") @db.VarChar(255)
  role          UserRole
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  maxChatId     BigInt?   @map("max_chat_id")

  maxBridgeId   String    @unique @map("max_bridge_id") @db.VarChar(255)

  volunteer     Volunteer?
  organization  Organization?
  broadcasts  BroadcastHistory[]

  @@index([email])
  @@map("users")
}

model Volunteer {
  id         Int       @id @default(autoincrement())
  userId     Int       @unique @map("user_id")
  lastName   String    @map("last_name") @db.VarChar(100)
  firstName  String    @map("first_name") @db.VarChar(100)
  middleName String?   @map("middle_name") @db.VarChar(100)
  birthDate  DateTime  @map("birth_date")
  phone      String?   @map("phone")
  city       String?    @db.VarChar(100)
  address    String?   @db.VarChar(512)
  latitude   Decimal?  @db.Decimal(9, 6)
  longitude  Decimal?  @db.Decimal(9, 6)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user           User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  registrations  VolunteerEventRegistration[]

  @@index([city])
  @@index([latitude, longitude])
  @@map("volunteers")
}

model Organization {
  id                    Int       @id @default(autoincrement())
  userId                Int       @unique @map("user_id")
  name                  String    @db.VarChar(255)
  isOfficial            Boolean   @default(false) @map("is_official")
  documentsZipFilename  String?   @map("documents_zip_filename") @db.VarChar(255)
  logoUrl               String?   @map("logo_url") @db.VarChar(512)
  socialMediaLink       String?   @map("social_media_link") @db.VarChar(512)
  contacts              String?
  description           String?
  address               String?   @db.VarChar(512)
  city                  String?   @db.VarChar(100)
  latitude              Decimal?  @db.Decimal(9, 6)
  longitude             Decimal?  @db.Decimal(9, 6)
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  events Event[]

  @@index([city])
  @@index([latitude, longitude])
  @@map("organizations")
}

// ==========================================
// 4. МЕРОПРИЯТИЯ
// ==========================================

model Event {
  id                      Int       @id @default(autoincrement())
  organizationId          Int       @map("organization_id")
  name                    String    @db.VarChar(255)
  photoUrl                String?   @map("photo_url") @db.VarChar(512)
  description             String?
  organizationalDetails   String?   @map("organizational_details")
  criteria                String?
  address                 String?   @db.VarChar(512)
  city                    String?   @db.VarChar(100)
  latitude                Decimal?  @db.Decimal(9, 6)
  longitude               Decimal?  @db.Decimal(9, 6)
  requiredVolunteersCount Int       @default(1) @map("required_volunteers_count")
  eventDate               DateTime  @map("event_date")
  endTime                 DateTime? @map("end_time")              // ← новое поле
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  minAge                  Int?      @map("min_age")


  // Связи
  organization  Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents     EventDocument[]
  registrations VolunteerEventRegistration[]
  photos        EventPhoto[]
  broadcasts  BroadcastHistory[]

  @@index([city, eventDate])
  @@index([organizationId])
  @@map("events") 
}


model EventPhoto {
  id        Int      @id @default(autoincrement())
  eventId   Int      @map("event_id")
  url       String   @db.VarChar(512)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_photos")
}

// ==========================================
// 5. ДОКУМЕНТЫ МЕРОПРИЯТИЙ
// ==========================================

model EventDocument {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  filePath    String   @map("file_path") @db.VarChar(512)
  description String?
  createdAt   DateTime @default(now()) @map("created_at")

  // Связи
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@map("event_documents")
}

// ==========================================
// 6. ЗАПИСЬ ВОЛОНТЕРОВ НА МЕРОПРИЯТИЯ (M:N)
// ==========================================

model VolunteerEventRegistration {
  id           Int                @id @default(autoincrement())
  volunteerId  Int                @map("volunteer_id")
  eventId      Int                @map("event_id")
  status       RegistrationStatus @default(pending)
  registeredAt DateTime           @default(now()) @map("registered_at")

  // Связи
  volunteer Volunteer @relation(fields: [volunteerId], references: [id], onDelete: Cascade)
  event     Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Защита от двойной записи
  @@unique([volunteerId, eventId])
  @@index([volunteerId])
  @@map("volunteer_event_registrations")
}

// ==========================================
// 7. История рассылок
// ==========================================


model BroadcastHistory {
  id          Int      @id @default(autoincrement())
  eventId     Int      @map("event_id")
  senderId    Int      @map("sender_id")
  text        String
  sentCount   Int      @map("sent_count")
  totalCount  Int      @map("total_count")
  createdAt   DateTime @default(now()) @map("created_at")

  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  sender      User     @relation(fields: [senderId], references: [id])

  @@map("broadcast_history")
}